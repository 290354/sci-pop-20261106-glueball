[
 {
  "s": 0.0,
  "e": 3.816,
  "text": "它一个夸克都没有，却真实存在。"
 },
 {
  "s": 4.236,
  "e": 7.716,
  "text": "它没有夸克。一个都没有。"
 },
 {
  "s": 8.136,
  "e": 11.736,
  "text": "可它有质量，就写在粒子名单上。"
 },
 {
  "s": 12.156,
  "e": 17.676,
  "text": "你身上每一克肉，靠的都是夸克。它偏偏一个都没有。"
 },
 {
  "s": 18.096,
  "e": 20.184,
  "text": "它叫胶球。"
 },
 {
  "s": 20.604,
  "e": 22.836,
  "text": "那就拆一个看看？"
 },
 {
  "s": 23.256,
  "e": 27.984,
  "text": "问题是，拆不动。夸克根本拎不出来。"
 },
 {
  "s": 28.404,
  "e": 33.156,
  "text": "往两边撕，力不会变弱，反而越拉越紧。"
 },
 {
  "s": 33.576,
  "e": 36.624,
  "text": "像一根永远拉不断的橡皮筋。"
 },
 {
  "s": 37.044,
  "e": 42.372,
  "text": "能量够了，啪一下断成两根，断口冒出两个新夸克。"
 },
 {
  "s": 42.792,
  "e": 45.672,
  "text": "粒子物理管这叫禁闭。"
 },
 {
  "s": 46.092,
  "e": 51.396,
  "text": "胶球里装的不是夸克，是胶子。同样拎不出来。"
 },
 {
  "s": 51.816,
  "e": 56.04,
  "text": "胶子，是把夸克粘在一起的传力粒子。"
 },
 {
  "s": 56.46,
  "e": 59.772,
  "text": "可它有个毛病：自己带色荷。"
 },
 {
  "s": 60.192,
  "e": 64.728,
  "text": "三种色，三种反色，它自己挂着一种。"
 },
 {
  "s": 65.148,
  "e": 70.332,
  "text": "引力不吃自己，电磁力也几乎不吃，胶子吃。"
 },
 {
  "s": 70.752,
  "e": 78.792,
  "text": "所以它不只粘夸克，也粘胶子：两个粘在一起，再粘上第三个，就成了结。"
 },
 {
  "s": 79.212,
  "e": 85.644,
  "text": "结打住了，就是一颗球——一颗只由胶子打成的球，叫胶球。"
 },
 {
  "s": 86.064,
  "e": 89.856,
  "text": "四十年前，理论就算出它该存在。"
 },
 {
  "s": 90.276,
  "e": 93.204,
  "text": "可一直没人把它造出来。"
 },
 {
  "s": 93.624,
  "e": 95.616,
  "text": "第二个坑来了。"
 },
 {
  "s": 96.036,
  "e": 101.268,
  "text": "胶子没有静止质量，那胶球的质量从哪来？"
 },
 {
  "s": 101.688,
  "e": 109.176,
  "text": "能量。胶子被关在球里，跑不掉，只能绕圈、碰撞、来回弹。"
 },
 {
  "s": 109.596,
  "e": 114.348,
  "text": "能量锁进极小的空间，锁得越紧，质量越大。"
 },
 {
  "s": 114.768,
  "e": 119.136,
  "text": "所以它比质子还重，明明什么都没装。"
 },
 {
  "s": 119.556,
  "e": 124.188,
  "text": "再往深一层：把一颗质子的质量拆开算账。"
 },
 {
  "s": 124.608,
  "e": 130.728,
  "text": "三个夸克自己只占百分之一，剩下九十九是胶子场的能量。"
 },
 {
  "s": 131.148,
  "e": 134.94,
  "text": "你身体的重量，几乎全是力变的。"
 },
 {
  "s": 135.36,
  "e": 140.736,
  "text": "不是先有物质再拿胶水粘——是胶水自己凝成了物质。"
 },
 {
  "s": 141.156,
  "e": 145.332,
  "text": "这话听着像哲学，其实是能算的物理。"
 },
 {
  "s": 145.752,
  "e": 149.28,
  "text": "可四十年，没人敢指认一颗。"
 },
 {
  "s": 149.7,
  "e": 157.38,
  "text": "难在哪？得先造出来：北京正负电子对撞机，让电子和正电子对撞。"
 },
 {
  "s": 157.8,
  "e": 164.736,
  "text": "2009 年，碎片里出现一个可疑的亮点，编号 X(2370)。"
 },
 {
  "s": 165.156,
  "e": 169.26,
  "text": "它太像一锅粥，一半以上的信号是干扰。"
 },
 {
  "s": 169.68,
  "e": 173.328,
  "text": "要指认它，得凑齐三样证据。"
 },
 {
  "s": 173.748,
  "e": 176.076,
  "text": "第一样，质量。"
 },
 {
  "s": 176.496,
  "e": 182.28,
  "text": "第二样，自旋和宇称。这一项，他们算了十三年。"
 },
 {
  "s": 182.7,
  "e": 185.316,
  "text": "第三样，味单态。"
 },
 {
  "s": 185.736,
  "e": 191.112,
  "text": "质量这一关，对上了，和超算曲线几乎重合。"
 },
 {
  "s": 191.532,
  "e": 196.908,
  "text": "旋转也对上了。它是个赝标量——照镜子会翻面。"
 },
 {
  "s": 197.328,
  "e": 202.152,
  "text": "最后一关最难：上百亿个事例，一颗一颗筛。"
 },
 {
  "s": 202.572,
  "e": 207.348,
  "text": "2026 年 8 月，巴西，国际高能物理大会。"
 },
 {
  "s": 207.768,
  "e": 210.648,
  "text": "这道关，也过了。"
 },
 {
  "s": 211.068,
  "e": 217.98,
  "text": "从 2009 到这天，十七年；往前追，四十年，五代人。"
 },
 {
  "s": 218.4,
  "e": 224.232,
  "text": "大会为它加了一场特别报告，这种规格好几年才碰上一次。"
 },
 {
  "s": 224.652,
  "e": 229.836,
  "text": "确认了什么？它的主要成分，就是最轻的胶球。"
 },
 {
  "s": 230.256,
  "e": 234.984,
  "text": "它重 2.37 GeV，约是质子的 2.5 倍。"
 },
 {
  "s": 235.404,
  "e": 239.532,
  "text": "听着不起眼，这是五十年来最实的一步。"
 },
 {
  "s": 239.952,
  "e": 244.128,
  "text": "但得把话说满：它不是纯胶球。"
 },
 {
  "s": 244.548,
  "e": 248.58,
  "text": "混了多少夸克态，还没单独测出来。"
 },
 {
  "s": 249.0,
  "e": 253.704,
  "text": "判定也依赖模型，模型一换，数字就动。"
 },
 {
  "s": 254.124,
  "e": 258.132,
  "text": "你摸到的胳膊，其实是胶子场的能量。"
 },
 {
  "s": 258.552,
  "e": 262.536,
  "text": "它只存在极短的一瞬，拿不到手里。"
 },
 {
  "s": 262.956,
  "e": 266.772,
  "text": "可这些边界，正是它最值钱的地方。"
 },
 {
  "s": 267.192,
  "e": 270.768,
  "text": "它说明，纸上那套规则是真的。"
 },
 {
  "s": 271.188,
  "e": 274.932,
  "text": "回到最开始。零个夸克。"
 },
 {
  "s": 275.352,
  "e": 279.336,
  "text": "却有质量，能占住名单上的一格。"
 },
 {
  "s": 279.756,
  "e": 284.988,
  "text": "它证明的不是宇宙多奇怪，是我们看错了主角。"
 },
 {
  "s": 285.408,
  "e": 290.904,
  "text": "胶子才是肉：你身上 99% 的重量，都是力。"
 },
 {
  "s": 291.324,
  "e": 295.068,
  "text": "我们只是刚刚确认，力自己也能站住。"
 },
 {
  "s": 295.488,
  "e": 298.848,
  "text": "物质，是力打出来的一个结。"
 },
 {
  "s": 299.268,
  "e": 303.78,
  "text": "如果力能打结，宇宙里还有多少个结没被找到？"
 }
]