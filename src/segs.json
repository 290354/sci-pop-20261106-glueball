[
 {
  "text": "它一个夸克都没有，却真实存在。",
  "cap": "零个夸克",
  "hold": 0.42
 },
 {
  "text": "它没有夸克。一个都没有。",
  "cap": "一个都没有",
  "hold": 0.42
 },
 {
  "text": "可它有质量，就写在粒子名单上。",
  "cap": "粒子名单上的一名",
  "hold": 0.42
 },
 {
  "text": "你身上每一克肉，靠的都是夸克。它偏偏一个都没有。",
  "cap": "你：全是夸克",
  "hold": 0.42
 },
 {
  "text": "它叫胶球。",
  "cap": "胶球",
  "hold": 0.42
 },
 {
  "text": "那就拆一个看看？",
  "cap": "拆一个看看？",
  "hold": 0.42
 },
 {
  "text": "问题是，拆不动。夸克根本拎不出来。",
  "cap": "拎不出来",
  "hold": 0.42
 },
 {
  "text": "往两边撕，力不会变弱，反而越拉越紧。",
  "cap": "越拉越紧",
  "hold": 0.42
 },
 {
  "text": "像一根永远拉不断的橡皮筋。",
  "cap": "啪",
  "hold": 0.42
 },
 {
  "text": "能量够了，啪一下断成两根，断口冒出两个新夸克。",
  "cap": "越撕越多",
  "hold": 0.42
 },
 {
  "text": "粒子物理管这叫禁闭。",
  "cap": "禁闭",
  "hold": 0.42
 },
 {
  "text": "胶球里装的不是夸克，是胶子。同样拎不出来。",
  "cap": "胶子也拎不出来",
  "hold": 0.42
 },
 {
  "text": "胶子，是把夸克粘在一起的传力粒子。",
  "cap": "胶子 = 传力的粒子",
  "hold": 0.42
 },
 {
  "text": "可它有个毛病：自己带色荷。",
  "cap": "胶子自己带色荷",
  "hold": 0.42
 },
 {
  "text": "三种色，三种反色，它自己挂着一种。",
  "cap": "三种色 · 三种反色",
  "hold": 0.42
 },
 {
  "text": "引力不吃自己，电磁力也几乎不吃，胶子吃。",
  "cap": "胶子吃自己",
  "hold": 0.42
 },
 {
  "text": "所以它不只粘夸克，也粘胶子：两个粘在一起，再粘上第三个，就成了结。",
  "cap": "力，自己打了结",
  "hold": 0.42
 },
 {
  "text": "结打住了，就是一颗球——一颗只由胶子打成的球，叫胶球。",
  "cap": "胶球 glueball",
  "hold": 0.42
 },
 {
  "text": "四十年前，理论就算出它该存在。",
  "cap": "预言在四十年前",
  "hold": 0.42
 },
 {
  "text": "可一直没人把它造出来。",
  "cap": "",
  "hold": 0.42
 },
 {
  "text": "第二个坑来了。",
  "cap": "第二个坑",
  "hold": 0.42
 },
 {
  "text": "胶子没有静止质量，那胶球的质量从哪来？",
  "cap": "质量从哪来？",
  "hold": 0.42
 },
 {
  "text": "能量。胶子被关在球里，跑不掉，只能绕圈、碰撞、来回弹。",
  "cap": "跑不掉 → 攒能量",
  "hold": 0.42
 },
 {
  "text": "能量锁进极小的空间，锁得越紧，质量越大。",
  "cap": "锁得越紧",
  "hold": 0.42
 },
 {
  "text": "所以它比质子还重，明明什么都没装。",
  "cap": "比质子还重",
  "hold": 0.42
 },
 {
  "text": "再往深一层：把一颗质子的质量拆开算账。",
  "cap": "更深一层",
  "hold": 0.42
 },
 {
  "text": "三个夸克自己只占百分之一，剩下九十九是胶子场的能量。",
  "cap": "夸克：1%",
  "hold": 0.42
 },
 {
  "text": "你身体的重量，几乎全是力变的。",
  "cap": "你的重量 = 力",
  "hold": 0.42
 },
 {
  "text": "不是先有物质再拿胶水粘——是胶水自己凝成了物质。",
  "cap": "胶水就是物质",
  "hold": 0.42
 },
 {
  "text": "这话听着像哲学，其实是能算的物理。",
  "cap": "四十年，没认出来",
  "hold": 0.42
 },
 {
  "text": "可四十年，没人敢指认一颗。",
  "cap": "",
  "hold": 0.42
 },
 {
  "text": "难在哪？得先造出来：北京正负电子对撞机，让电子和正电子对撞。",
  "cap": "北京 · 正负电子对撞机",
  "hold": 0.42
 },
 {
  "text": "2009 年，碎片里出现一个可疑的亮点，编号 X(2370)。",
  "cap": "X(2370)",
  "hold": 0.42
 },
 {
  "text": "它太像一锅粥，一半以上的信号是干扰。",
  "cap": "本底：超过 50%",
  "hold": 0.42
 },
 {
  "text": "要指认它，得凑齐三样证据。",
  "cap": "要凑齐三样",
  "hold": 0.42
 },
 {
  "text": "第一样，质量。",
  "cap": "一 · 质量",
  "hold": 0.42
 },
 {
  "text": "第二样，自旋和宇称。这一项，他们算了十三年。",
  "cap": "二 · 自旋宇称",
  "hold": 0.42
 },
 {
  "text": "第三样，味单态。",
  "cap": "三 · 味单态",
  "hold": 0.42
 },
 {
  "text": "质量这一关，对上了，和超算曲线几乎重合。",
  "cap": "质量：对上",
  "hold": 0.42
 },
 {
  "text": "旋转也对上了。它是个赝标量——照镜子会翻面。",
  "cap": "自旋宇称：对上",
  "hold": 0.42
 },
 {
  "text": "最后一关最难：上百亿个事例，一颗一颗筛。",
  "cap": "最难的一关",
  "hold": 0.42
 },
 {
  "text": "2026 年 8 月，巴西，国际高能物理大会。",
  "cap": "2026 年 8 月",
  "hold": 0.42
 },
 {
  "text": "这道关，也过了。",
  "cap": "",
  "hold": 0.42
 },
 {
  "text": "从 2009 到这天，十七年；往前追，四十年，五代人。",
  "cap": "十七年 · 五代人",
  "hold": 0.42
 },
 {
  "text": "大会为它加了一场特别报告，这种规格好几年才碰上一次。",
  "cap": "特别报告",
  "hold": 0.42
 },
 {
  "text": "确认了什么？它的主要成分，就是最轻的胶球。",
  "cap": "主要成分：最轻胶球",
  "hold": 0.42
 },
 {
  "text": "它重 2.37 GeV，约是质子的 2.5 倍。",
  "cap": "2.37 GeV ≈ 2.5 个质子",
  "hold": 0.42
 },
 {
  "text": "听着不起眼，这是五十年来最实的一步。",
  "cap": "五十年来最实的一步",
  "hold": 0.42
 },
 {
  "text": "但得把话说满：它不是纯胶球。",
  "cap": "不是纯胶球",
  "hold": 0.42
 },
 {
  "text": "混了多少夸克态，还没单独测出来。",
  "cap": "混了多少？不知道",
  "hold": 0.42
 },
 {
  "text": "判定也依赖模型，模型一换，数字就动。",
  "cap": "依赖模型",
  "hold": 0.42
 },
 {
  "text": "你摸到的胳膊，其实是胶子场的能量。",
  "cap": "",
  "hold": 0.42
 },
 {
  "text": "它只存在极短的一瞬，拿不到手里。",
  "cap": "只存在一瞬",
  "hold": 0.42
 },
 {
  "text": "可这些边界，正是它最值钱的地方。",
  "cap": "边界 = 价值",
  "hold": 0.42
 },
 {
  "text": "它说明，纸上那套规则是真的。",
  "cap": "",
  "hold": 0.42
 },
 {
  "text": "回到最开始。零个夸克。",
  "cap": "零个夸克",
  "hold": 0.42
 },
 {
  "text": "却有质量，能占住名单上的一格。",
  "cap": "却有质量",
  "hold": 0.42
 },
 {
  "text": "它证明的不是宇宙多奇怪，是我们看错了主角。",
  "cap": "看错了主角",
  "hold": 0.42
 },
 {
  "text": "胶子才是肉：你身上 99% 的重量，都是力。",
  "cap": "99% 是力",
  "hold": 0.42
 },
 {
  "text": "我们只是刚刚确认，力自己也能站住。",
  "cap": "",
  "hold": 0.42
 },
 {
  "text": "物质，是力打出来的一个结。",
  "cap": "力打出来的结",
  "hold": 0.42
 },
 {
  "text": "如果力能打结，宇宙里还有多少个结没被找到？",
  "cap": "还有多少个结？",
  "hold": 1.4
 }
]